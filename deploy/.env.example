# === 배포 환경 변수 (deploy/.env 로 복사 후 값 입력) ===

# Google Gemini API 키 (필수)
GEMINI_API_KEY=AIza...

# 관리자 토큰 (필수) — 문서 관리·운영 지표 API 보호
ADMIN_TOKEN=change-me

# 모델 (선택)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# 서비스 도메인 (도메인 연결 시 HTTPS 자동 발급)
# 도메인 없이 IP로 테스트하려면 :80 유지
SITE_ADDRESS=:80
# CORS 용 오리진 (도메인 연결 시 https://도메인 으로 변경)
SITE_ORIGIN=http://localhost
