# Google Gemini API (없으면 자동으로 목업 모드로 동작)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# 모델 설정 (선택)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# 관리자 토큰 (필수) — 문서 관리·운영 지표 API 보호
# 미설정 시 해당 API는 503으로 차단됩니다. 배포 시 긴 랜덤 문자열로 설정하세요.
ADMIN_TOKEN=change-me

# 데이터 경로 (선택)
DATA_DIR=./data

# CORS 허용 오리진 (선택, 쉼표 구분) — 배포 시 프론트엔드 도메인으로 변경
CORS_ORIGINS=http://localhost:3000
