# Google Gemini API (없으면 자동으로 목업 모드로 동작)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# 모델 설정 (선택)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# 관리자 토큰 (필수) — 문서 관리·운영 지표 API 보호
# 미설정 시 해당 API는 503으로 차단됩니다. 배포 시 긴 랜덤 문자열로 설정하세요.
ADMIN_TOKEN=change-me

# 데이터 경로 (선택)
DATA_DIR=./data

# CORS 허용 오리진 (선택, 쉼표 구분) — 배포 시 프론트엔드 도메인으로 변경
CORS_ORIGINS=http://localhost:3000

# 답변에서 지울 실명 목록 (선택, 쉼표 구분). 미설정 시 api/private_names.txt를 읽는다.
# 전화번호·계좌번호·이메일은 목록 없이도 정규식으로 마스킹된다.
PRIVATE_NAMES=홍길동,김철수

# 규정 검토·감사 분석·종합 조정 모델 (선택). 기본 gemini. claude로 켜면 Claude 호출 실패 시 그 단계만 Gemini로 폴백
# AGENT_PROVIDER=claude
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=low
# 모델·effort를 올리면 함께 올린다 (기본: effort low면 30초, 그 외 90초)
# CLAUDE_TIMEOUT=
# Gemini 경로의 규정 검토·감사 분석 사고 수준 (선택, low/medium/high)
# AGENT_THINKING=
