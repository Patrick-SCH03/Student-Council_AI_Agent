# Claude API (질문 분류·규정 검토·감사 분석·종합 조정·문서 OCR)
# CLAUDE_API_KEY와 고른 공급자의 임베딩 키(기본 GEMINI_API_KEY)가 모두 있어야 실제로 동작한다. 하나라도 없으면 목업 모드.
CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=low
# 모델·effort를 올리면 함께 올린다 (기본: effort low면 30초, 그 외 90초)
# CLAUDE_TIMEOUT=

# 검색 임베딩 공급자 (gemini | voyage, 기본 gemini). 바꾸면 전체 재색인이 필요하다.
# EMBEDDING_PROVIDER=gemini
# Gemini API (검색 임베딩). 키는 Generative Language API로 제한해 두면 유출 피해가 줄어든다.
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Voyage AI (예비 임베딩 공급자). 결제 수단 없이는 분당 3요청·1만 토큰
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-4

# 관리자 토큰 (필수) — 문서 관리·운영 지표 API 보호
# 미설정 시 해당 API는 503으로 차단됩니다. 배포 시 긴 랜덤 문자열로 설정하세요.
ADMIN_TOKEN=change-me

# 데이터 경로 (선택)
DATA_DIR=./data

# CORS 허용 오리진 (선택, 쉼표 구분) — 배포 시 프론트엔드 도메인으로 변경
CORS_ORIGINS=http://localhost:3000

# 답변에서 지울 실명 목록 (선택, 쉼표 구분). 미설정 시 api/private_names.txt를 읽는다.
# 전화번호·계좌번호·이메일은 목록 없이도 정규식으로 마스킹된다.
PRIVATE_NAMES=홍길동,김철수
